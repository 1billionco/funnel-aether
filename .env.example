# Funnel Aether environment. Copy to .env.local for local dev.
# Every key is optional: a missing key degrades to a clearly labelled mock.
# Full reference: docs/ENV.md. Never commit real values.

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (local: `pnpm db:start`, then copy values from `pnpm exec supabase status`) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=           # server only; bypasses RLS

# --- AI (mock generator when ANTHROPIC_API_KEY is empty) ---
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=claude-haiku-5-5      # verify current ID in Anthropic docs
LLM_MODEL_SMART=claude-sonnet-5-5    # verify current ID in Anthropic docs
GEMINI_API_KEY=                      # optional fallback; see docs/PRIVACY_NOTES.md before enabling
GEMINI_MODEL=                        # verify in Google AI Studio
GENERATION_DEADLINE_MS=25000         # abort streamed generation before the Netlify sync limit

# --- Embeddings (deterministic mock when empty) ---
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4-lite
EMBEDDING_DIM=1024

# --- Credits & cost guardrails ---
CREDIT_VALUE_USD=0.002
AI_DAILY_BUDGET_USD=5

# --- Background / scheduled functions ---
BACKGROUND_FN_SECRET=                # long random string: openssl rand -hex 32
CRON_SECRET=                         # long random string

# --- Email (mock sender when empty) ---
RESEND_API_KEY=
EMAIL_FROM_DOMAIN=                   # e.g. mail.funnelaether.com (verified in Resend)

# --- Payments (test mode by default: use sk_test_ keys) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GROWTH_GBP=
STRIPE_PRICE_ADVANCED_GBP=
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_GROWTH_NGN=
PAYSTACK_PLAN_ADVANCED_NGN=

# --- Product analytics & errors (off when empty) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_DSN=

# --- Founder admin ---
FOUNDER_ADMIN_EMAILS=                # comma-separated
